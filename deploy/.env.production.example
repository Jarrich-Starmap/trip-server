# 生产环境变量样例（参考用，勿直接入库）
#
# 实际部署由 ecosystem.config.cjs 的 env_production 注入；
# 其中 TOKEN_SECRET 由 deploy.sh 在部署机用 `openssl rand -hex 32` 现场生成并注入，
# 不落库、不进版本控制。
#
# 如需本地手动调试，可复制本文件为 .env 后 `source .env` 再 node server.js。

PORT=8099
HOST=127.0.0.1
DEV_MODE=false
DATA_FILE=/var/lib/kids-trip/db.json

# 生产必须替换为强随机值（deploy.sh 自动生成，这里仅占位）
TOKEN_SECRET=__GENERATE_WITH__openssl_rand_hex_32__

TOKEN_TTL_DAYS=7
WECHAT_APPID=YOUR_WECHAT_APPID
# 微信凭证请在部署机环境变量中设置，切勿写入仓库
WECHAT_SECRET=YOUR_WECHAT_SECRET

AI_MODEL=template
RL_GUIDE_PER_SPOT_DAY=10
RL_COMMENT_PER_HOUR=60
MODERATION=true
AI_REVIEW_AUTO_RETRY_FAILED=false
